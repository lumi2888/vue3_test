<!--practice.vue watch 情況四 - 函數回傳一個值(getter)-->
<template>
    <div class="practice">
        <h2>姓名:{{practice.name}}</h2>
        <h2>年齡:{{practice.age}}</h2>
        <h2>汽車:{{practice.car.c1}}、{{ practice.car.c2}}</h2>
        <button @click="changeName">修改名字</button>
        <button @click="changeAge">修改年齡</button>
        <button @click="changeC1">修改第一台車</button>
        <button @click="changeC2">修改第二台車</button>
        <button @click="changeCar">修改整個車</button>
    </div>
</template>

<script lang="ts" setup name="Practice">
import {reactive,watch} from 'vue'

//數據
let practice = reactive({
    name:'張三',
    age:18,
    //對象類型
    car:{
        c1:'toyota',
        c2:'tesla'
    }
})
//方法
function changeName(){
    practice.name += '~'
}
function changeAge(){
    practice.age += 1
}
function changeC1(){
    practice.car.c1 = '奧迪'
}
function changeC2(){
    practice.car.c2 = '大眾'
}
function changeCar(){
    practice.car = {c1:'雅迪',c2:'艾瑪'}
}

// ()=> :代表函式簡寫 (function [方法名]{ })
// 監視響應式對象中的某個屬性，且基本類型的屬性，需寫成函數式(getter 回傳一個值)。
/*
watch(()=>practice.name,(newValue,oldValue)=>{
    console.log('practice變化',newValue,oldValue)
})
*/

// 監視響應式對象中的某個屬性，且對象類型的屬性，可直接寫，也可寫函數式。
watch(()=>practice.car,(newValue,oldValue)=>{
    console.log('person.car變化',newValue,oldValue)
},{deep:true})
</script>

<!--註: 
      直接寫法:
      watch(practice.car, (newValue, oldValue) => { ... })
      - 自動深度監視
      - 適用情況: 改屬性，不換整個物件(practice.car = {c1:'雅迪',c2:'艾瑪'})
      函數式(getter):
      watch(()=>practice.car,(newValue,oldValue)=>{ ... })
      - 適用情況: 可改內部屬性與換整個物件
      - 需手動加 {deep:true} 才會監視內部屬性
      -->
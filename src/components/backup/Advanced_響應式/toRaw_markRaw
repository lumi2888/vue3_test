<script lang="ts" setup name="App">

import {reactive,toRaw,markRaw} from 'vue'

let person = reactive({
  name:'tony',
  age:18
})

/* toRaw:用於取得響應式物件(person)的原本物件(person2)，
且回傳的物件不再是響應式，也不會觸發頁面更新 */
// person2: toRaw 回傳 person
let person2 = toRaw(person)

/* markRaw: 標記一個物件，使其一定不會變成響應式 */
let car = markRaw({brand:'toyota',price:100})
let car2 = reactive(car) // 被標記
</script>

<template>
  <div class="app">
    <h2>姓名: {{person2.name}}</h2>
    <h2>年齡: {{person2.age}}</h2>
    <button @click="person2.age += 1">修改年齡</button>
    <hr>
    <h2>{{ car2 }}</h2>
    <button @click="car2.price += 10">price +10</button>

</template>


<!--Practice.vue ref 的標籤屬性-->
<template>
    <div class="practice">
        <h1>Taiwan</h1>
        <h2 ref="title2">US</h2>
        <h3>Japan</h3>
        <button @click="showLog">country</button>
    </div>
</template>

<script lang="ts" setup name="Practice">
import {ref} from 'vue'

// 建立 title2，用於儲存 ref 標記的內容
let title2 = ref()

let a = ref(0)
let b = ref(1)
let c = ref(2)

function showLog(){
    console.log(title2.value)
}

// 公開內部變數，讓父元件能讀取
defineExpose({a,b,c})
</script>

<!--ref 標籤屬性
    Practice.vue(子組件)
    App.vue(父組件)
    - title2 -> HTML DOM
    - ren -> component(組件)實例 有保護機制，所以需透過 defineExpose()
    
-->

<!--App.vue -->

<!--setup:自動處理元件設定-->
<script setup name="App"> // name 不寫時則為預設名
import HelloWorld from './components/HelloWorld.vue'
import TheWelcome from './components/TheWelcome.vue'
import Person from './components/Person.vue'
import Practice from './components/Practice.vue'
import {ref} from 'vue'

let title2 = ref()
let ren = ref()

function showLog(){
  console.log(title2.value)
  console.log(ren.value)
}
</script>

<!--寫 HTML 結構 Ex:顯示 Person 元件-->
<template>
  <header>
    <img alt="Vue logo" class="logo" src="./assets/logo.svg" width="125" height="125" />

    <div class="wrapper">
      <HelloWorld msg="You did it!" />
      <h2 ref="title2">你好</h2>
      <button @click="showLog">result</button>
      <button @click="showLog">test</button>
      <Person />
      <Practice ref="ren" />
    </div>
  </header>

  <main>
    <TheWelcome />
  </main>
</template>

